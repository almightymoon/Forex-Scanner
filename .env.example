# Database
DATABASE_URL=postgresql://fxnav:fxnav_dev@localhost:5432/fxnavigators
COLLECTOR_DATABASE_URL=postgresql://fxnav:fxnav_dev@localhost:5432/fxnavigators
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
MARKET_API_KEY=

# Market data collector
COLLECTOR_READ_ENABLED=true
COLLECTOR_DAEMON_ENABLED=true
ENABLE_COLLECTOR_DAEMON=false
COLLECTOR_SQLITE_PATH=data/collector.db

# Market Data — simulation is EXPLICIT opt-in only (never inferred from ENVIRONMENT)
# Forbidden when ENVIRONMENT=production|prod|live (hard error at startup).
ENVIRONMENT=development
ENABLE_SIMULATED_DATA=false

# Provider priority: Twelve Data → Polygon (see config/market.yaml)
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=

# MT5 (Windows + MetaTrader5 terminal required)
# Enable in config/data_collector.yaml: providers.mt5.enabled

# AI (explanations only)
OPENAI_API_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587

# Optional paper/shadow emit gate (default off). Example after H4 provisional pass:
# SCANNER_EMIT_POLICY=h4_rank1_liquidity_none
# SCANNER_EMIT_POLICY=

# Phase-2-prep paper broker (default off). Journals OOS-parity fills; not live venue orders.
# PAPER_BROKER_ENABLED=true
# PAPER_BROKER_ENABLED=

# Live venue stubs (default: no venue — OANDA not required). See docs/BROKER_VENUES.md
# BROKER_VENUE=none
# BROKER_VENUE=oanda
# BROKER_VENUE_ORDERS_ENABLED=false
# OANDA_ENV=practice

# HTF drift telemetry (observational only)
# HTF_DRIFT_TELEMETRY=false


# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Scanner daemon (set true to auto-scan when API starts)
# Keep false on free-tier Twelve Data — continuous scans exhaust daily credits.
ENABLE_SCANNER_DAEMON=false
# Slow down full-universe scans to stay under free-tier rate limits (seconds)
# SCAN_INTERVAL_SECONDS=300
# MIN_ALERT_SCORE=70

# Prometheus: docker compose --profile monitoring up -d
